---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'HighHit' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f7f7f2" />
    <title>{title}</title>
    <meta
      name="description"
      content="Discover your habits, understand your mood, and experiment with what helps you thrive."
    />
  </head>
  <body>
    <slot />
  </body>
</html>